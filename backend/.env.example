# X-Line API configuration. Copy to `.env` and fill in. Never commit the real `.env`.

NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Public origin of this API — used to build image URLs returned by uploads.
PUBLIC_URL=http://localhost:4000

# MySQL
DATABASE_URL="mysql://root:password@localhost:3306/xline"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Uploads are written to ./uploads and served from /uploads.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=12
IMAGE_FULL_WIDTH=1920
IMAGE_QUALITY=82

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10

# Used once by `npm run db:seed`. Change the password after first sign-in.
ADMIN_EMAIL=admin@x-line.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=X-Line Administrator

# The refresh token is an httpOnly cookie. Site and API on different domains: set COOKIE_SAMESITE=none (needs HTTPS).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true   # defaults to true in production or when SAMESITE=none
